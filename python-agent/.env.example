# ============================================================
# 医疗智能Agent v2 环境变量配置（复制为 .env 后修改）
# ============================================================

# --- LLM（OpenAI 兼容协议，任意厂商均可：DeepSeek/通义/豆包/GLM） ---
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# --- Agent 编排 ---
AGENT_MAX_ITERATIONS=6
AGENT_MEMORY_WINDOW=10
TOOL_TIMEOUT=8

# --- RAG ---
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.5

# --- Redis（会话记忆；不可用时自动降级进程内存） ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# --- MySQL（工具数据源） ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=healthapp2

# --- 服务 ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
RATE_LIMIT_PER_MINUTE=30
